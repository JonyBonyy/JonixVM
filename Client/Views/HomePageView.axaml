<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Client.Views.HomePageView">

    <UserControl.Styles>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5A7D8E" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4B6B7A" />
        </Style>

        <!-- VM Card Button Hover & Press Effects -->
        <Style Selector="Button.vm-card /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5E4E8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Button.vm-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F4FAFB" />
            <Setter Property="BorderBrush" Value="#5A7D8E" />
        </Style>
        <Style Selector="Button.vm-card:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E3F1F4" />
        </Style>

        <!-- Card Gear Button Hover -->
        <Style Selector="Button.card-gear /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EEF5F7" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.card-gear:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5A7D8E" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <SplitView DisplayMode="Inline"
                   OpenPaneLength="240"
                   IsPaneOpen="{Binding #SidebarToggle.IsChecked}">

            <!-- 1. Sidebar -->
            <SplitView.Pane>
                <Border Padding="20,80,20,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#5A7D8E" />
                            <GradientStop Offset="1" Color="#2A4552" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid RowDefinitions="*, Auto">

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel Spacing="12">

                                <Button Content="☁ Cloud VMs"
                                        Click="CloudVmsButton_Click"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Height="45"
                                        CornerRadius="10"
                                        Foreground="White"
                                        Background="#25FFFFFF"
                                        Padding="15,0,0,0" />

                                <Button Content="🖥 Local VMs"
                                        Click="LocalVmsButton_Click"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Height="45"
                                        CornerRadius="10"
                                        Foreground="White"
                                        Background="#25FFFFFF"
                                        Padding="15,0,0,0" />

                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Spacing="12">
                            <Button Content="☼ Theme"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Height="45"
                                    CornerRadius="10"
                                    Foreground="White"
                                    Background="#10FFFFFF"
                                    Padding="15,0,0,0" />

                            <Button Content="👤 Users"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Height="45"
                                    CornerRadius="10"
                                    Foreground="White"
                                    Background="#20FFFFFF"
                                    Padding="15,0,0,0" />

                            <Button Content="Log In"
                                    Click="LoginButtonClick"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Height="45"
                                    CornerRadius="10"
                                    Foreground="#2A4552"
                                    Background="White" />
                        </StackPanel>
                    </Grid>
                </Border>
            </SplitView.Pane>

            <!-- 2. Main Content -->
            <SplitView.Content>
                <Panel>
                    <Panel.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0" Color="#D9F0F0" />
                            <GradientStop Offset="0.5" Color="#EAF5F5" />
                            <GradientStop Offset="1" Color="White" />
                        </LinearGradientBrush>
                    </Panel.Background>

                    <TextBlock x:Name="WelcomeText"
                               Text="JonixVM"
                               FontSize="90"
                               FontWeight="Heavy"
                               Foreground="#2A4552"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <!-- VM Dashboard Grid (Cloud or Local) -->
                    <Grid x:Name="VmGridView"
                          IsVisible="False"
                          RowDefinitions="Auto, *"
                          Margin="40,80,40,40">

                        <TextBlock x:Name="VmGridTitle"
                                   Grid.Row="0"
                                   Text="Cloud VMs"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#2A4552"
                                   Margin="0,0,0,25" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="VmCardsPanel"
                                       Orientation="Horizontal" />
                        </ScrollViewer>
                    </Grid>

                    <!-- New / Edit Local VM Wizard: Hidden by default -->
                    <Border x:Name="CreateVmForm"
                            IsVisible="False"
                            Width="480"
                            Height="395"
                            Background="White"
                            CornerRadius="16"
                            Padding="26"
                            BoxShadow="0 8 24 0 #20000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <Grid RowDefinitions="Auto, *, Auto">

                            <!-- Row 0: Form Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
                                <Button Grid.Column="0"
                                        Content="✕"
                                        Click="CancelCreateForm_Click"
                                        Background="Transparent"
                                        Foreground="#5A7D8E"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        VerticalAlignment="Top" />

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Name="LocalFormTitle"
                                               Text="Create New Local VM"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#2A4552"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="StepSubtitle"
                                               Text="Step 1: Basic Information"
                                               FontSize="13"
                                               Foreground="#5A7D8E"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="2" Width="30" />
                            </Grid>

                            <!-- Row 1: Step Content -->
                            <Panel Grid.Row="1" VerticalAlignment="Center">

                                <!-- STEP 1: Name & ISO -->
                                <StackPanel x:Name="Step1Panel" Spacing="14" IsVisible="True">
                                    <TextBox x:Name="VmNameInput"
                                             Watermark="VM Name"
                                             Height="42"
                                             VerticalContentAlignment="Center"
                                             TextChanged="LocalStep1_Changed" />

                                    <Grid ColumnDefinitions="*, 10, Auto">
                                        <TextBox x:Name="IsoPathInput"
                                                 Grid.Column="0"
                                                 Watermark="No ISO file selected..."
                                                 IsReadOnly="True"
                                                 Height="42"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="LocalStep1_Changed" />

                                        <Button Grid.Column="2"
                                                Content="Browse ISO"
                                                Click="BrowseIsoButton_Click"
                                                Height="42"
                                                Padding="15,0"
                                                Background="#5A7D8E"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                VerticalContentAlignment="Center"
                                                CornerRadius="8" />
                                    </Grid>

                                    <TextBlock x:Name="LocalStep1Error"
                                               Text="Please enter a VM name and select an ISO file."
                                               Foreground="#D9534F"
                                               FontSize="12"
                                               IsVisible="False" />
                                </StackPanel>

                                <!-- STEP 2: Hardware (RAM & CPU Sliders) -->
                                <StackPanel x:Name="Step2Panel" Spacing="16" IsVisible="False">

                                    <!-- RAM Slider -->
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="RAM Allocation" FontWeight="SemiBold" Foreground="#2A4552" />
                                            <TextBlock x:Name="RamValueText" Grid.Column="1" Text="0 MB" FontWeight="Bold" Foreground="#5A7D8E" />
                                        </Grid>
                                        <Slider x:Name="RamSlider"
                                                Minimum="0"
                                                Maximum="8192"
                                                Value="2048"
                                                TickFrequency="256"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="HardwareSlider_ValueChanged" />
                                    </StackPanel>

                                    <!-- CPU Cores Slider -->
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="CPU Cores" FontWeight="SemiBold" Foreground="#2A4552" />
                                            <TextBlock x:Name="CoresValueText" Grid.Column="1" Text="0 Cores" FontWeight="Bold" Foreground="#5A7D8E" />
                                        </Grid>
                                        <Slider x:Name="CoresSlider"
                                                Minimum="0"
                                                Maximum="8"
                                                Value="2"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="HardwareSlider_ValueChanged" />
                                    </StackPanel>

                                </StackPanel>

                                <!-- STEP 3: Storage & Network -->
                                <StackPanel x:Name="Step3Panel" Spacing="14" IsVisible="False">

                                    <!-- Virtual Disk Slider -->
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Virtual Disk Size (qcow2)" FontWeight="SemiBold" Foreground="#2A4552" />
                                            <TextBlock x:Name="DiskValueText" Grid.Column="1" Text="20 GB" FontWeight="Bold" Foreground="#5A7D8E" />
                                        </Grid>
                                        <Slider x:Name="DiskSlider"
                                                Minimum="5"
                                                Maximum="200"
                                                Value="20"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="HardwareSlider_ValueChanged" />
                                    </StackPanel>

                                    <!-- Network Mode -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Network Mode" FontWeight="SemiBold" Foreground="#2A4552" />
                                        <ComboBox x:Name="NetworkModeCombo"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  Height="40"
                                                  VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="NAT (Default - Internet Access)" />
                                            <ComboBoxItem Content="Bridged (Direct LAN)" />
                                            <ComboBoxItem Content="None (Offline / Isolated)" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Hardware Acceleration Toggle -->
                                    <CheckBox x:Name="KvmCheckBox"
                                              Content="Enable KVM Hardware Acceleration"
                                              IsChecked="True"
                                              Foreground="#2A4552"
                                              FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- STEP 4: Summary & Confirm -->
                                <Border x:Name="Step4Panel"
                                        IsVisible="False"
                                        Background="#F4F8F9"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Review Configuration" FontWeight="Bold" Foreground="#2A4552" FontSize="14" Margin="0,0,0,2" />

                                        <Grid ColumnDefinitions="100, *">
                                            <TextBlock Text="Name:" Foreground="#5A7D8E" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock x:Name="SummaryName" Grid.Column="1" Foreground="#2A4552" FontWeight="Bold" FontSize="13" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100, *">
                                            <TextBlock Text="ISO Path:" Foreground="#5A7D8E" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock x:Name="SummaryIso" Grid.Column="1" Foreground="#2A4552" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100, *">
                                            <TextBlock Text="RAM:" Foreground="#5A7D8E" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock x:Name="SummaryRam" Grid.Column="1" Foreground="#2A4552" FontSize="13" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100, *">
                                            <TextBlock Text="CPU Cores:" Foreground="#5A7D8E" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock x:Name="SummaryCores" Grid.Column="1" Foreground="#2A4552" FontSize="13" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100, *">
                                            <TextBlock Text="Disk Size:" Foreground="#5A7D8E" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock x:Name="SummaryDisk" Grid.Column="1" Foreground="#2A4552" FontSize="13" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100, *">
                                            <TextBlock Text="Network:" Foreground="#5A7D8E" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock x:Name="SummaryNetwork" Grid.Column="1" Foreground="#2A4552" FontSize="13" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100, *">
                                            <TextBlock Text="KVM:" Foreground="#5A7D8E" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock x:Name="SummaryKvm" Grid.Column="1" Foreground="#2A4552" FontSize="13" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </Panel>

                            <!-- Row 2: Navigation Bar pinned to bottom -->
                            <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,12,0,0">
                                <Button x:Name="BackStepButton"
                                        Grid.Column="0"
                                        Content="←"
                                        Click="BackStepButton_Click"
                                        IsEnabled="False"
                                        Width="55" Height="42"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="#EAF5F5"
                                        Foreground="#2A4552"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        CornerRadius="8" />

                                <TextBlock x:Name="StepIndicatorText"
                                           Grid.Column="1"
                                           Text="1 / 4"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#2A4552"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <Button x:Name="NextStepButton"
                                        Grid.Column="2"
                                        Content="→"
                                        Click="NextStepButton_Click"
                                        MinWidth="55" Height="42"
                                        Padding="15,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="#5A7D8E"
                                        Foreground="White"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        CornerRadius="8" />
                            </Grid>

                        </Grid>
                    </Border>

                    <!-- New / Edit Cloud VM Form: Hidden by default -->
                    <Border x:Name="CreateCloudVmForm"
                            IsVisible="False"
                            Width="480"
                            Background="White"
                            CornerRadius="16"
                            Padding="30"
                            BoxShadow="0 8 24 0 #20000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <StackPanel Spacing="20">

                            <!-- Form Header -->
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Button Grid.Column="0"
                                        Content="✕"
                                        Click="CancelCreateForm_Click"
                                        Background="Transparent"
                                        Foreground="#5A7D8E"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        VerticalAlignment="Top" />

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="CloudFormTitle"
                                               Text="Create New Cloud VM"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#2A4552"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Hosted on JonixVM Cloud (Shared Server Resources)"
                                               FontSize="13"
                                               Foreground="#5A7D8E"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="2" Width="30" />
                            </Grid>

                            <!-- VM Name + Inline Validation -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="VM Name" FontWeight="SemiBold" Foreground="#2A4552" />
                                <TextBox x:Name="CloudVmNameInput"
                                         Watermark="I use Arch btw"
                                         Height="42"
                                         VerticalContentAlignment="Center"
                                         TextChanged="CloudVmNameInput_TextChanged" />
                                <TextBlock x:Name="CloudVmNameError"
                                           Text="VM name cannot be empty."
                                           Foreground="#D9534F"
                                           FontSize="12"
                                           IsVisible="False" />
                            </StackPanel>

                            <!-- Server-Hosted OS Dropdown -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Operating System" FontWeight="SemiBold" Foreground="#2A4552" />
                                <ComboBox x:Name="CloudOsCombo"
                                          SelectedIndex="0"
                                          HorizontalAlignment="Stretch"
                                          Height="42"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Ubuntu" />
                                    <ComboBoxItem Content="Arch Linux" />
                                    <ComboBoxItem Content="Fedora" />
                                    <ComboBoxItem Content="Windows 11" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Create / Save Button -->
                            <Button x:Name="CreateCloudVmButton"
                                    Content="Create Cloud VM"
                                    Click="CreateCloudVmButton_Click"
                                    IsEnabled="False"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Height="45"
                                    Margin="0,10,0,0"
                                    Background="#5A7D8E"
                                    Foreground="White"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    CornerRadius="8" />

                        </StackPanel>
                    </Border>

                </Panel>
            </SplitView.Content>

        </SplitView>

        <!-- 3. Open/Close button -->
        <ToggleButton x:Name="SidebarToggle"
                      IsChecked="true"
                      Content="☰"
                      FontSize="24"
                      FontWeight="Bold"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Width="45" Height="45"
                      CornerRadius="10"
                      Foreground="White"
                      Background="#5A7D8E"
                      Margin="20,20,0,0" />
    </Panel>
</UserControl>