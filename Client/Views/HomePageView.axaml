<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Client.Views.HomePageView">

    <UserControl.Styles>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5A7D8E" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4B6B7A" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <SplitView DisplayMode="Inline"
                   OpenPaneLength="240"
                   IsPaneOpen="{Binding #SidebarToggle.IsChecked}">

            <!-- 1. Sidebar -->
            <SplitView.Pane>
                <Border Padding="20,80,20,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#5A7D8E" />
                            <GradientStop Offset="1" Color="#2A4552" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid RowDefinitions="Auto, *, Auto">

                        <Button Grid.Row="0"
                                Content="⚙ Settings"
                                FontSize="16"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Height="45"
                                CornerRadius="10"
                                Foreground="White"
                                Background="#20FFFFFF"
                                Padding="15,0,0,0" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,25,0,0">
                            <StackPanel Spacing="12">

                                <!-- Cloud Section -->
                                <TextBlock Text="CLOUD"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#AAFFFFFF"
                                           Margin="6,0,0,0" />

                                <Button Content="+ New Cloud VM"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Height="45"
                                        CornerRadius="10"
                                        Foreground="White"
                                        Background="#33FFFFFF"
                                        Padding="15,0,0,0" />

                                <Button Content="🖥 Cloud VMs"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Height="45"
                                        CornerRadius="10"
                                        Foreground="White"
                                        Background="#20FFFFFF"
                                        Padding="15,0,0,0" />

                                <!-- Local Section -->
                                <TextBlock Text="LOCAL"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#AAFFFFFF"
                                           Margin="6,18,0,0" />

                                <Button Content="+ New Local VM"
                                        Click="NewVmButton_Click"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Height="45"
                                        CornerRadius="10"
                                        Foreground="White"
                                        Background="#33FFFFFF"
                                        Padding="15,0,0,0" />

                                <Button Content="🖥 Local VMs"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Height="45"
                                        CornerRadius="10"
                                        Foreground="White"
                                        Background="#20FFFFFF"
                                        Padding="15,0,0,0" />

                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Spacing="12">
                            <Button Content="☼ Theme"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Height="45"
                                    CornerRadius="10"
                                    Foreground="White"
                                    Background="#10FFFFFF"
                                    Padding="15,0,0,0" />

                            <Button Content="👤 Users"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Height="45"
                                    CornerRadius="10"
                                    Foreground="White"
                                    Background="#20FFFFFF"
                                    Padding="15,0,0,0" />

                            <Button Content="Log In"
                                    Click="LoginButtonClick"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Height="45"
                                    CornerRadius="10"
                                    Foreground="#2A4552"
                                    Background="White" />
                        </StackPanel>
                    </Grid>
                </Border>
            </SplitView.Pane>

            <!-- 2. Main Content -->
            <SplitView.Content>
                <Panel>
                    <Panel.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0" Color="#D9F0F0" />
                            <GradientStop Offset="0.5" Color="#EAF5F5" />
                            <GradientStop Offset="1" Color="White" />
                        </LinearGradientBrush>
                    </Panel.Background>

                    <TextBlock x:Name="WelcomeText"
                               Text="JonixVM"
                               FontSize="90"
                               FontWeight="Heavy"
                               Foreground="#2A4552"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <!-- New VM Creation Wizard: Hidden by default -->
                    <Border x:Name="CreateVmForm"
                            IsVisible="False"
                            Width="480"
                            Background="White"
                            CornerRadius="16"
                            Padding="30"
                            BoxShadow="0 8 24 0 #20000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <StackPanel Spacing="20">

                            <!-- Form Header -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Create New Virtual Machine"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#2A4552"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="StepSubtitle"
                                           Text="Step 1: Basic Information"
                                           FontSize="14"
                                           Foreground="#5A7D8E"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- STEP 1: Name & ISO -->
                            <StackPanel x:Name="Step1Panel" Spacing="15" IsVisible="True">
                                <TextBox x:Name="VmNameInput"
                                         Watermark="VM Name"
                                         Height="42"
                                         VerticalContentAlignment="Center" />

                                <Grid ColumnDefinitions="*, 10, Auto">
                                    <TextBox x:Name="IsoPathInput"
                                             Grid.Column="0"
                                             Watermark="No ISO file selected..."
                                             IsReadOnly="True"
                                             Height="42"
                                             VerticalContentAlignment="Center" />

                                    <Button Grid.Column="2"
                                            Content="Browse ISO"
                                            Click="BrowseIsoButton_Click"
                                            Height="42"
                                            Padding="15,0"
                                            Background="#5A7D8E"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            VerticalContentAlignment="Center"
                                            CornerRadius="8" />
                                </Grid>
                            </StackPanel>

                            <!-- STEP 2: Hardware (RAM & CPU Sliders) -->
                            <StackPanel x:Name="Step2Panel" Spacing="20" IsVisible="False">

                                <!-- RAM Slider -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="RAM Allocation" FontWeight="SemiBold" Foreground="#2A4552" />
                                        <TextBlock x:Name="RamValueText" Grid.Column="1" Text="0 MB" FontWeight="Bold" Foreground="#5A7D8E" />
                                    </Grid>
                                    <Slider x:Name="RamSlider"
                                            Minimum="0"
                                            Maximum="8192"
                                            Value="2048"
                                            TickFrequency="256"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="HardwareSlider_ValueChanged" />
                                </StackPanel>

                                <!-- CPU Cores Slider -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="CPU Cores" FontWeight="SemiBold" Foreground="#2A4552" />
                                        <TextBlock x:Name="CoresValueText" Grid.Column="1" Text="0 Cores" FontWeight="Bold" Foreground="#5A7D8E" />
                                    </Grid>
                                    <Slider x:Name="CoresSlider"
                                            Minimum="0"
                                            Maximum="8"
                                            Value="2"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="HardwareSlider_ValueChanged" />
                                </StackPanel>

                            </StackPanel>

                            <!-- STEP 3: Storage & Network -->
                            <StackPanel x:Name="Step3Panel" Spacing="18" IsVisible="False">

                                <!-- Virtual Disk Slider -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="Virtual Disk Size (qcow2)" FontWeight="SemiBold" Foreground="#2A4552" />
                                        <TextBlock x:Name="DiskValueText" Grid.Column="1" Text="20 GB" FontWeight="Bold" Foreground="#5A7D8E" />
                                    </Grid>
                                    <Slider x:Name="DiskSlider"
                                            Minimum="5"
                                            Maximum="200"
                                            Value="20"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="HardwareSlider_ValueChanged" />
                                </StackPanel>

                                <!-- Network Mode -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Network Mode" FontWeight="SemiBold" Foreground="#2A4552" />
                                    <ComboBox x:Name="NetworkModeCombo"
                                              SelectedIndex="0"
                                              HorizontalAlignment="Stretch"
                                              Height="42"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="NAT (Default - Internet Access)" />
                                        <ComboBoxItem Content="Bridged (Direct LAN)" />
                                        <ComboBoxItem Content="None (Offline / Isolated)" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Hardware Acceleration Toggle -->
                                <CheckBox x:Name="KvmCheckBox"
                                          Content="Enable KVM Hardware Acceleration"
                                          IsChecked="True"
                                          Foreground="#2A4552"
                                          FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- STEP 4: Summary & Confirm -->
                            <Border x:Name="Step4Panel"
                                    IsVisible="False"
                                    Background="#F4F8F9"
                                    CornerRadius="10"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Review Configuration" FontWeight="Bold" Foreground="#2A4552" FontSize="15" Margin="0,0,0,4" />

                                    <Grid ColumnDefinitions="110, *">
                                        <TextBlock Text="Name:" Foreground="#5A7D8E" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SummaryName" Grid.Column="1" Foreground="#2A4552" FontWeight="Bold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="110, *">
                                        <TextBlock Text="ISO Path:" Foreground="#5A7D8E" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SummaryIso" Grid.Column="1" Foreground="#2A4552" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid ColumnDefinitions="110, *">
                                        <TextBlock Text="RAM:" Foreground="#5A7D8E" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SummaryRam" Grid.Column="1" Foreground="#2A4552" />
                                    </Grid>
                                    <Grid ColumnDefinitions="110, *">
                                        <TextBlock Text="CPU Cores:" Foreground="#5A7D8E" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SummaryCores" Grid.Column="1" Foreground="#2A4552" />
                                    </Grid>
                                    <Grid ColumnDefinitions="110, *">
                                        <TextBlock Text="Disk Size:" Foreground="#5A7D8E" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SummaryDisk" Grid.Column="1" Foreground="#2A4552" />
                                    </Grid>
                                    <Grid ColumnDefinitions="110, *">
                                        <TextBlock Text="Network:" Foreground="#5A7D8E" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SummaryNetwork" Grid.Column="1" Foreground="#2A4552" />
                                    </Grid>
                                    <Grid ColumnDefinitions="110, *">
                                        <TextBlock Text="KVM:" Foreground="#5A7D8E" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SummaryKvm" Grid.Column="1" Foreground="#2A4552" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Navigation Bar: [ <- ]   "1 / 4"   [ -> ] -->
                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,10,0,0">
                                <Button x:Name="BackStepButton"
                                        Grid.Column="0"
                                        Content="←"
                                        Click="BackStepButton_Click"
                                        IsEnabled="False"
                                        Width="55" Height="42"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="#EAF5F5"
                                        Foreground="#2A4552"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        CornerRadius="8" />

                                <TextBlock x:Name="StepIndicatorText"
                                           Grid.Column="1"
                                           Text="1 / 4"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#2A4552"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <Button x:Name="NextStepButton"
                                        Grid.Column="2"
                                        Content="→"
                                        Click="NextStepButton_Click"
                                        MinWidth="55" Height="42"
                                        Padding="15,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="#5A7D8E"
                                        Foreground="White"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        CornerRadius="8" />
                            </Grid>

                        </StackPanel>
                    </Border>

                </Panel>
            </SplitView.Content>

        </SplitView>

        <!-- 3. Open/Close button -->
        <ToggleButton x:Name="SidebarToggle"
                      IsChecked="true"
                      Content="☰"
                      FontSize="24"
                      FontWeight="Bold"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Width="45" Height="45"
                      CornerRadius="10"
                      Foreground="White"
                      Background="#5A7D8E"
                      Margin="20,20,0,0" />
    </Panel>
</UserControl>