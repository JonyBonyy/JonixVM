<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="Client.Views.LoginView">

    <!-- Wrap the entire app in a Panel and apply the gradient here instead -->
    <Panel>
        <Panel.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,10%">
                <GradientStop Offset="0" Color="#a5d6d6" />
                <GradientStop Offset="1" Color="White" />
            </LinearGradientBrush>
        </Panel.Background>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
        
        <!-- FIXED: Bumped font size slightly to bridge the gap with the main window title -->
        <TextBlock Text="Log In"
                   FontSize="50"
                   FontWeight="SemiLight"
                   Foreground="#1a1a2e"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>
                   
        <TextBox x:Name="Username"
                 Watermark="Username"
                 Width="300"/>
                 
        <TextBox x:Name="Password"
                 Watermark="Password"
                 Width="300"
                 PasswordChar="*"
                 Classes="revealPasswordButton"/>
        
        <!-- FIXED: Height unified to 50 to match MainWindow exactly -->
        <Button Content="Continue"
                Click="SubmitLogin_Click"
                Width="300" Height="50"
                Background="#374752"
                Foreground="White"
                FontSize="16"
                FontWeight="SemiBold"
                CornerRadius="8"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Margin="0,10,0,-5"/>
                
        <Button Content="Back"
                Click="BackButton_Click"
                Width="300" Height="50"
                Background="Transparent"
                Foreground="#1a1a2e"
                FontSize="14"
                FontWeight="Medium"
                CornerRadius="8"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>
                
    </StackPanel>
        </Panel>
</UserControl>