<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="JonixVM"
        MinHeight="400" MinWidth="750"
        WindowStartupLocation="CenterScreen"> 

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Wrap the entire app in a Panel and apply the gradient here instead -->
    <Panel>
        <Panel.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,10%">
                <GradientStop Offset="0" Color="#a5d6d6" />
                <GradientStop Offset="1" Color="White" />
            </LinearGradientBrush>
        </Panel.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="40">
                
            <TextBlock Text="JonixVM"
                       FontSize="75"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#4a5d6e" />
                        <GradientStop Offset="1" Color="#4aa" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                
                <Button Content="Log In"
                        Click="NavigateToLogin_Click"
                        Width="300" Height="50"
                        Background="#374752"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        CornerRadius="8" 
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
                
                <Button Content="Sign up" 
                        Click="NavigateToSignup_Click"
                        Width="300" Height="50"
                        Background="#374752"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        CornerRadius="8"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

                <Button Content="Continue without"
                        Click="NavigateToHomePage_Click"
                        Width="300" Height="50"
                        Background="Transparent"
                        Foreground="#1a1a2e"
                        FontSize="15"
                        FontWeight="SemiBold"
                        CornerRadius="8"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
                        
            </StackPanel>
        </StackPanel>
    </Panel>
</Window>