<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="Client.Views.SigninView">
    <StackPanel Margin="0 0,0,250" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Sign in"
                   FontSize="50"
                   Margin="20"
                   HorizontalAlignment="Center"/>
        <TextBox Watermark="Username"
                 Width="300"/>
        <TextBox Watermark="Password"
                 Width="300"
                 PasswordChar="*"/>
        <TextBox Watermark="Confirm Password"
                 Width="300"
                 PasswordChar="*"/>
        <Button Content="Log in" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>